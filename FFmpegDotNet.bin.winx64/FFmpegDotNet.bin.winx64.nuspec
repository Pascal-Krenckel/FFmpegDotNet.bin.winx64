<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>FFmpegDotNet.bin.winx64</id>
    <version>8.1.2.5</version>
    <title>FFmpeg Binaries for Windows (x64)</title>
    <authors>Pascal Krenckel</authors>
    <owners>Pascal Krenckel</owners>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>

    <license type="file">LICENSE.txt</license>
    <readme>README.md</readme>
    <releaseNotes>
		Latest Auto-Build (2026-09-01 13:13) by BtbN:
		https://github.com/BtbN/FFmpeg-Builds/releases
		Includes the executables as well as the shared libraries (DLLs) for Windows x64.
		The libraries will be copied to ffmpeg\win-x64.
	</releaseNotes>
    <description>
      This package contains the LGPL FFmpeg 8.1.2 "Hoare" binaries for Windows x64.
      Use this package with FFmpegDotNet if you do not want to provide the FFmpeg libraries yourself.
    </description>

	<dependencies>
		<dependency id="FFmpegDotNet._AutoGen" version="[8.0.0,9.0.0)" />
	</dependencies>
  </metadata>

  <files>
    <!-- Native FFmpeg libraries -->
    <file
      src="ffmpeg\win-x64\**"
      target="runtimes\win-x64\native\ffmpeg" />
	  <file
      src="..\LICENSE.txt"
      target="runtimes\win-x64\native\ffmpeg" />

    <!-- MSBuild integration for PackageReference -->
    <file
      src="FFmpegDotNet.bin.winx64.props"
      target="buildTransitive\" />


    <!-- Package documentation -->
    <file
      src="..\LICENSE.txt"
      target="" />

    <file
      src="..\README.md"
      target="" />
  </files>
</package>
