<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>FFmpegDotNet.bin.winx64</id>
    <version>8.1.2.4</version>
    <title>FFmpeg Binaries for Windows (x64)</title>
    <authors>Pascal Krenckel</authors>
    <owners>Pascal Krenckel</owners>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>

    <license type="file">LICENSE.txt</license>
    <readme>README.md</readme>
    <releaseNotes>
	    Changed to a new nuspec/package layout reducing the file size by half. Fixing the previous error. The dll included in contentFiles where still the old one, making build possible only for .net framework.
	</releaseNotes>
    <description>
      This package contains the LGPL FFmpeg 8.1.2 "Hoare" binaries for Windows x64.
      Use this package with FFmpegDotNet if you do not want to provide the FFmpeg libraries yourself.
    </description>

	<dependencies>
		<dependency id="FFmpegDotNet._AutoGen" version="[8.0.0,9.0.0)" />
	</dependencies>
  </metadata>

  <files>
    <!-- Native FFmpeg libraries -->
    <file
      src="ffmpeg\win-x64\**"
      target="runtimes\win-x64\native\ffmpeg" />
	  <file
      src="..\LICENSE.txt"
      target="runtimes\win-x64\native\ffmpeg" />

    <!-- MSBuild integration for PackageReference -->
    <file
      src="FFmpegDotNet.bin.winx64.props"
      target="buildTransitive\" />


    <!-- Package documentation -->
    <file
      src="..\LICENSE.txt"
      target="" />

    <file
      src="..\README.md"
      target="" />
  </files>
</package>
