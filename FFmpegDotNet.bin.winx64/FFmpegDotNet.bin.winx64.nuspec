<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>FFmpegDotNet.bin.winx64</id>
    <version>9.0.1.0</version>
    <title>FFmpeg Binaries for Windows (x64)</title>
    <authors>Pascal Krenckel</authors>
    <owners>Pascal Krenckel</owners>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>

    <license type="file">LICENSE.txt</license>
    <readme>README.md</readme>
    <releaseNotes>
		Latest Auto-Build (2026-09-01 13:13) by BtbN:
		https://github.com/BtbN/FFmpeg-Builds/releases
		Includes the executables as well as the shared libraries (DLLs) for Windows x64.
	</releaseNotes>
    <description>
		This package contains the LGPL FFmpeg 9.0.1 "Lei" binaries for Windows x64.
		Use this package with FFmpegDotNet if you do not want to provide the FFmpeg libraries yourself.
		The package includes the FFmpeg executables for Windows x64.
		The files will be copied to ./ffmpeg/win-x64/.
	</description>

	<dependencies>
		<dependency id="FFmpegDotNet._AutoGen" version="[9.0.0,10.0.0)" />
	</dependencies>
  </metadata>

  <files>
    <!-- Native FFmpeg libraries -->
    <file
      src="ffmpeg\win-x64\**"
      target="ffmpeg\win-x64" />
	  <file
      src="..\LICENSE.txt"
      target="ffmpeg\win-x64" />

    <!-- MSBuild integration for PackageReference -->
    <file
      src="FFmpegDotNet.bin.winx64.props"
      target="buildTransitive\" />


    <!-- Package documentation -->
    <file
      src="..\LICENSE.txt"
      target="" />

    <file
      src="..\README.md"
      target="" />
  </files>
</package>
